        
        <div class="timeline-page">
            <?php $no =1; foreach ($experience as $value): 
                $mod = $no++%2===0;
                ?>
                <div class="timeline-item">
                    <div class="row">
                        <?php if ($mod): ?>
                            <div class="timeline-item">
                                <div class="row">
                                    <div class="col-lg-6 col-md-6 col-sm-6 order-sm-1 order-2">
                                        <div class="event event-description-right">
                                            <h4><?= $value->office ?> </h4><span class="text-muted"><?= $value->role ?></span>
                                            <p class="timeline-subtitle text-muted"><?= $value->description ?></p>
                                        </div>
                                    </div><!--end col-->
                                    <div class="col-lg-6 col-md-6 col-sm-6 order-sm-2 order-1">
                                        <div class="duration duration-right "><?= date("M Y", strtotime($value->start_at)) ?> - <?= $value->end_at ?  date("M Y", strtotime($value->end_at)) : "Sekarang" ?></div>
                                    </div><!--end col-->
                                </div><!--end row-->
                            </div><!--end timeline-page-->

                        <?php else: ?>
                            <div class="timeline-item">
                                <div class="row">
                                    <div class="col-lg-6 col-md-6 col-sm-6">
                                        <div class="duration date-label-left"> <?= date("M Y", strtotime($value->start_at)) ?> - <?= $value->end_at ?  date("M Y", strtotime($value->end_at)) : "Sekarang" ?></div>
                                    </div><!--end col-->
                                    <div class="col-lg-6 col-md-6 col-sm-6">
                                        <div class="event event-description-right">
                                            <h4><?= $value->office ?> </h4><span class="text-muted"><?= $value->role ?></span>
                                            <p class="timeline-subtitle text-muted"><?= $value->description ?></p>
                                        </div>
                                    </div><!--end col-->
                                </div><!--end row-->
                            </div><!--end timeline-page-->
                        <?php endif ?>
                    </div><!--end row-->
                </div><!--end timeline-page-->
                
            <?php endforeach ?>

        </div><!--end timeline-page-->